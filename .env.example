# --- Обязательные ---
TELEGRAM_BOT_TOKEN=            # токен от @BotFather
TELEGRAM_CHAT_ID=              # пусто = режим настройки (бот пришлёт ваш chat id на /start)

# --- Окружение ---
TZ=Europe/Kyiv
DATA_DIR=                      # по умолчанию $RAILWAY_VOLUME_MOUNT_PATH или ./data
LOG_LEVEL=INFO
MEMORY_LIMIT_MB=450
DRY_RUN=0                      # 1 = печатать алерты в stdout вместо Telegram
MEXC_FUTURES_REST_BASE=https://contract.mexc.com
ENABLE_BYBIT=auto              # auto|on|off
ENABLE_HYPERLIQUID=auto
ENABLE_BINANCE=auto            # в v1 только проверка доступности
DAILY_REPORT_HOUR=9
MEXC_LINK_TEMPLATE=https://futures.mexc.com/exchange/{symbol}

# --- Пороги (можно менять и через /set) ---
COST_ROUND_TRIP_PCT=0.15
MIN_TURNOVER_24H_USD=300000
TIER2_MAX=15
MAX_ALERTS_PER_HOUR=12
# Полный список порогов: команда /config или scalpbot/config.py (TUNABLES).
